<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	
	<parent>
		<groupId>fr.pacman.validation</groupId>
		<artifactId>pacman-database-parent</artifactId>
		<version>1.0.0</version>
	</parent>
	
	<artifactId>fr.pacman.database.validation.nommage.update</artifactId>
	<packaging>eclipse-repository</packaging>
	<name>fr.pacman.database.validation.nommage.update</name>
	<description>Update Site Pacman Validation Nommage Database.</description>

	<build>
		<plugins>
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>tycho-p2-repository-plugin</artifactId>
				<version>${tycho-version}</version>
				<configuration>
					<createArtifactRepository>true</createArtifactRepository>
					<!-- Changement ici : finalName = artifactId-version -->
					<finalName>${project.artifactId}-${project.version}</finalName>
				</configuration>
			</plugin>
			 <plugin>
        		<groupId>org.apache.maven.plugins</groupId>
        		<artifactId>maven-resources-plugin</artifactId>
        		<executions>
          			<execution>
            			<phase>verify</phase>
            			<goals>
              				<goal>resources</goal>
            			</goals>
          			</execution>
        		</executions>
        		<configuration>
          			<outputDirectory>${project.build.directory}</outputDirectory>
        		</configuration>
      		</plugin>
      		
            <!-- Injection des sources dans le zip final -->
            <plugin>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>add-sources-to-update-site</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <!-- Crée un répertoire temporaire -->
                                <mkdir dir="${project.build.directory}/update-site-temp"/>

                                <!-- Dézipper le zip Tycho généré -->
                                <unzip src="${project.build.directory}/${project.build.finalName}.zip"
                                       dest="${project.build.directory}/update-site-temp"/>

                                <!-- Copier tous les bundles .source générés par les plugins -->
                                <copy todir="${project.build.directory}/update-site-temp/plugins">
                                    <fileset dir="../fr.pacman.database.validation.nommage/target" includes="*-sources.jar"/>
                                    <fileset dir="../fr.pacman.database.validation.nommage.ui/target" includes="*-sources.jar"/>
                                    <fileset dir="../fr.pacman.database.validation/target" includes="*-sources.jar"/>
                                    <fileset dir="../fr.pacman.database.validation.ui/target" includes="*-sources.jar"/>
                                    <fileset dir="../fr.pacman.database.branding/target" includes="*-sources.jar"/>
                                </copy>

                                <!-- Rezipper le update site final avec les sources -->
                                <zip destfile="${project.build.directory}/${project.build.finalName}-with-sources.zip">
                                    <fileset dir="${project.build.directory}/update-site-temp"/>
                                </zip>

                                <!-- Nettoyage du répertoire temporaire -->
                                <delete dir="${project.build.directory}/update-site-temp"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
		</plugins>
	</build>
</project>
